menu "L2 shared counter"

config APP_COUNTER_USE_MUTEX
	bool "Protect the shared counter with a mutex"
	default y
	help
	  When enabled, each read-modify-write of the shared counter runs with
	  counter_lock held, so the final value always equals 2 * INCREMENTS.

	  Disable it to run the same loop without the lock and watch updates get
	  lost. No code change is needed, add the overlay at build time:
	    west build -b native_sim app -- -DEXTRA_CONF_FILE=unprotected.conf

endmenu

source "Kconfig.zephyr"
