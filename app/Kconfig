menu "L6 latency investigation"

config APP_CONTROL_PRIORITY
	int "Control thread priority"
	default 3
	help
	  Priority of the control thread (lower number = higher priority).

	  3 (default, the fix) is above the maintenance thread (4), so control
	  preempts maintenance as soon as an event is ready and starts within
	  the 10 ms deadline.

	  7 is the original value, below maintenance. Build with the before.conf
	  overlay to reproduce the deadline misses with the same workload and
	  detector:
	    west build -b native_sim app -- -DEXTRA_CONF_FILE=before.conf

endmenu

source "Kconfig.zephyr"
